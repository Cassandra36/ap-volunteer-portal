    selected_item                         = item_lookup.get(chosen, {})
    st.session_state.selected_event_id    = selected_item.get("id", "")

    st.write("")

    # ── CLOCK IN ──────────────────────────────────────────────────────────
    if st.session_state.start_time is None:
        if st.button("🟢  CLOCK IN", use_container_width=True):
            if not st.session_state.user_email:
                st.error("Enter your email in the sidebar first.")
            else:
                st.session_state.start_time = utc_now()
                dbg(f"Clocked IN | {chosen} | {st.session_state.start_time}")
                st.rerun()
    else:
        elapsed = fmt_duration(utc_now() - st.session_state.start_time)
        st.success(f"✅ Clocked in at {fmt_time(st.session_state.start_time)} — {elapsed} elapsed")

    # ── CLOCK OUT ─────────────────────────────────────────────────────────
    if st.session_state.start_time is not None:
        if st.button("🔴  CLOCK OUT", use_container_width=True):
            captured_start = st.session_state.start_time
            captured_end   = utc_now()
            duration       = captured_end - captured_start
            hours          = duration.total_seconds() / 3600
            dbg(f"Clocked OUT | {fmt_duration(duration)} ({hours:.4f}h)")

            pushed, push_err = False, ""
            if neon_configured() and st.session_state.account_id:
                item   = item_lookup.get(chosen, {})
                note   = f"Logged via Volunteer Portal – {chosen}"
                with st.spinner("Saving to NeonCRM…"):
                    pushed, push_err = push_shift_to_neon(
                        account_id = st.session_state.account_id,
                        item_id    = item.get("id", ""),
                        item_type  = item.get("type", ""),
                        start_dt   = captured_start,
                        end_dt     = captured_end,
                        hours      = hours,
                        note       = note,
                    )
                    if pushed:
                        fetch_volunteer_hours.clear()
                        h, _ = fetch_volunteer_hours(st.session_state.account_id)
                        st.session_state.total_hours = h

            st.session_state.history.append({
                "date":       to_local(captured_end).strftime("%b %d, %Y"),
                "event":      chosen,
                "clock_in":   fmt_time(captured_start),
                "clock_out":  fmt_time(captured_end),
                "duration_h": round(hours, 2),
            })
            if not pushed:
                st.session_state.total_hours = round(st.session_state.total_hours + hours, 2)

            st.session_state.start_time = None

            st.balloons()
            if pushed:
                st.success(f"✅ Saved to NeonCRM!\n\n**Duration:** {fmt_duration(duration)} · **{chosen}**")
            else:
                st.warning(f"Saved locally — NeonCRM push failed: {push_err}\n\n**Duration:** {fmt_duration(duration)}")

    st.write("")
    if not st.session_state.start_time:
