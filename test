# ---------------------------------------------------------------------------
# TIMEZONE
# ---------------------------------------------------------------------------
LOCAL_TZ = ZoneInfo("America/New_York")

def utc_now() -> datetime.datetime:
    return datetime.datetime.now(tz=datetime.timezone.utc)

def to_local(dt: datetime.datetime) -> datetime.datetime:
    return dt.astimezone(LOCAL_TZ)

def fmt_time(dt: datetime.datetime) -> str:
    return to_local(dt).strftime("%I:%M %p")

def fmt_duration(td: timedelta) -> str:
    total_seconds = int(abs(td.total_seconds()))
    h, rem = divmod(total_seconds, 3600)
    m, _   = divmod(rem, 60)
    return f"{h}h {m:02d}m"

# ---------------------------------------------------------------------------
# NEONCRM  — v2 only, with mandatory NEON-API-VERSION: 2.9 header
# ---------------------------------------------------------------------------
NEON_BASE    = "https://api.neoncrm.com/v2"
NEON_VERSION = "2.9"   # timesheets endpoint requires >= 2.9

def neon_configured() -> bool:
    try:
        _ = st.secrets["neon"]["api_key"]
        _ = st.secrets["neon"]["org_id"]
        return True
    except Exception:
        return False

def _neon_headers() -> dict:
    """
    NeonCRM v2 auth: HTTP Basic with org_id as username, api_key as password.
    NEON-API-VERSION header is required for v2.9+ endpoints like /timesheets.
    """
    org_id  = st.secrets["neon"]["org_id"]
    api_key = st.secrets["neon"]["api_key"]
    token   = base64.b64encode(f"{org_id}:{api_key}".encode()).decode()
    return {
        "Authorization":    f"Basic {token}",
        "Content-Type":     "application/json",
        "NEON-API-VERSION": NEON_VERSION,
    }

# ── Events ──────────────────────────────────────────────────────────────────
@st.cache_data(ttl=300)
def fetch_neon_events() -> tuple[list[dict], str]:
    today  = datetime.date.today().strftime("%Y-%m-%d")
    url    = f"{NEON_BASE}/events"
    # startDateOnOrAfter includes today; startDateAfter excludes today
    # Fetch a wide window and filter in Python — avoids uncertainty over
    # the exact NeonCRM param name for date filtering.
    params = {
        "currentPage":   0,
        "pageSize":      200,
        "sortColumn":    "startDate",
        "sortDirection": "ASC",
    }
    try:
        resp = requests.get(url, headers=_neon_headers(), params=params, timeout=10)
    except requests.exceptions.ConnectionError as e:
        return [], f"Connection error: {e}"
    except requests.exceptions.Timeout:
        return [], "Timed out after 10s."

    if resp.status_code == 401:
        return [], "401 Unauthorized — check org_id / api_key in secrets.toml."
    if not resp.ok:
        return [], f"HTTP {resp.status_code}: {resp.text[:300]}"

    try:
        raw = resp.json().get("events") or []
    except Exception as e:
        return [], f"JSON parse error: {e} — raw: {resp.text[:200]}"

    today_date = datetime.date.today()
    parsed = []
    for ev in raw:
        name      = ev.get("name", "Untitled")
        reg_open  = ev.get("enableEventRegistrationForm", False)
        start_str = ev.get("startDate", "")

        # Filter out templates and closed registration
        if "template" in name.lower() or not reg_open:
            continue

        # Filter out past events in Python (immune to API param name changes)
        if start_str:
            try:
                ev_date = datetime.date.fromisoformat(start_str)
                if ev_date < today_date:
                    continue
            except ValueError:
                pass

        parsed.append({
            "Event Id":                 str(ev.get("id", "")),
            "Event Name":               name,
            "Event Start Date":         ev.get("startDate", ""),
            "Event Start Time":         ev.get("startTime", ""),
            "Event Registration Count": str(ev.get("registrantCount", "") or ""),
            "Event Maximum Attendees":  str(ev.get("maximumAttendees", "") or ""),
        })
    return parsed, ""

# ── Volunteer Opportunities ──────────────────────────────────────────────────
@st.cache_data(ttl=300)
def fetch_neon_opportunities() -> tuple[list[dict], str]:
    """
    GET /opportunities — pulls volunteer opportunities (e.g. 'AT Home') from NeonCRM.
    These are the same options shown in the Opportunity dropdown when logging a timesheet.
    No status filter — we filter by status in Python to handle any casing NeonCRM returns.
    """
    url    = f"{NEON_BASE}/opportunities"
    params = {"currentPage": 0, "pageSize": 200}
    try:
        resp = requests.get(url, headers=_neon_headers(), params=params, timeout=10)
    except requests.exceptions.ConnectionError as e:
        return [], f"Connection error: {e}"
    except requests.exceptions.Timeout:
        return [], "Timed out after 10s."
    if not resp.ok:
        return [], f"HTTP {resp.status_code}: {resp.text[:300]}"
    try:
        body = resp.json()
        raw  = body.get("opportunities") or []
    except Exception as e:
        return [], f"JSON parse error: {e} — raw: {resp.text[:200]}"

    parsed = []
    for opp in raw:
        name   = opp.get("name", "Untitled")
        status = str(opp.get("status", "")).upper()

        # Only include active opportunities; skip templates
        if "template" in name.lower():
            continue
        if status and status not in ("ACTIVE", ""):
            continue

        parsed.append({
            "Event Id":                 f"opp_{opp.get('id', '')}",
            "Event Name":               name,
            "Event Start Date":         "",
            "Event Start Time":         "",
            "Event Registration Count": "",
            "Event Maximum Attendees":  "",
            "is_opportunity":           True,
            "opportunity_id":           str(opp.get("id", "")),
        })
    return parsed, ""


# ── Account lookup ───────────────────────────────────────────────────────────
@st.cache_data(ttl=60)
def fetch_account_id(email: str) -> tuple[str | None, str]:
    url    = f"{NEON_BASE}/accounts"
    params = {"userType": "INDIVIDUAL", "email": email, "currentPage": 0, "pageSize": 1}
    try:
        resp = requests.get(url, headers=_neon_headers(), params=params, timeout=10)
    except Exception as e:
        return None, str(e)
    if resp.status_code == 401:
        return None, "401 Unauthorized — check credentials."
    if not resp.ok:
        return None, f"HTTP {resp.status_code}: {resp.text[:200]}"
    try:
        accounts = resp.json().get("accounts") or []
        if accounts:
            return str(accounts[0].get("accountId", "")), ""
        return None, ""
    except Exception as e:
        return None, f"Parse error: {e}"

# ── Volunteer hours ──────────────────────────────────────────────────────────
@st.cache_data(ttl=60)
def fetch_volunteer_hours(account_id: str) -> float:
    """GET /timesheets?accountId=... — NeonCRM v2.9"""
    url    = f"{NEON_BASE}/timesheets"
    params = {"accountId": account_id, "currentPage": 0, "pageSize": 200}
    try:
        resp = requests.get(url, headers=_neon_headers(), params=params, timeout=10)
        if not resp.ok:
            return 0.0
        rows = resp.json().get("timesheets") or []
        return round(sum(float(r.get("hours", 0) or 0) for r in rows), 2)
    except Exception:
        return 0.0

# ── Push shift ───────────────────────────────────────────────────────────────
def push_shift_to_neon(account_id, event_id, start_dt, end_dt, hours, note="") -> tuple[bool, str]:
    """
    POST /timesheets — NeonCRM v2.9
    Required fields: accountId, hours, startDate
    Optional: endDate, startTime, endTime, eventId, note
    """
    url         = f"{NEON_BASE}/timesheets"
    local_start = start_dt.astimezone(LOCAL_TZ)
    local_end   = end_dt.astimezone(LOCAL_TZ)

    payload = {
        "accountId": account_id,          # string, not int
        "hours":     round(hours, 2),
        "startDate": local_start.strftime("%Y-%m-%d"),
        "endDate":   local_end.strftime("%Y-%m-%d"),
        "startTime": local_start.strftime("%H:%M:%S"),
        "endTime":   local_end.strftime("%H:%M:%S"),
        "note":      note,
    }
    if event_id and not str(event_id).startswith("opp_"):
        payload["eventId"] = event_id
    elif event_id and str(event_id).startswith("opp_"):
        payload["opportunityId"] = str(event_id).replace("opp_", "")

    try:
        resp = requests.post(url, headers=_neon_headers(), json=payload, timeout=10)
    except Exception as e:
        return False, f"Request failed: {e}"

    dbg(f"POST /timesheets → HTTP {resp.status_code} | {resp.text[:300]!r}")

    if resp.ok:
        return True, ""

    return False, f"HTTP {resp.status_code}: {resp.text[:400]}"

