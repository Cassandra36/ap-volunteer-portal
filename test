            display_options.append("── Opportunities ──")
        display_options.append(item["Event Name"])

    # Rebuild events_map to include separator-aware lookup
    name_to_id = {"General Volunteer": ""}
    for item in all_options_raw:
        name_to_id[item["Event Name"]] = item["Event Id"]

    # Remove separator from valid index targets
    SEPARATOR = "── Opportunities ──"
    valid_options = [o for o in display_options if o != SEPARATOR]

    # Clamp index
    if st.session_state.event_index >= len(display_options):
        st.session_state.event_index = 0

    chosen_event_raw = st.selectbox(
        "Which event are you volunteering for?",
        options=display_options,
        index=st.session_state.event_index,
        help="Events and opportunities pulled live from NeonCRM",
    )
    # If volunteer selects the separator line, bump to next valid item
    if chosen_event_raw == SEPARATOR:
        next_idx = display_options.index(SEPARATOR) + 1
        if next_idx < len(display_options):
            st.session_state.event_index = next_idx
            st.rerun()
        chosen_event = "General Volunteer"
    else:
        chosen_event = chosen_event_raw
    st.session_state.event_index          = display_options.index(chosen_event) if chosen_event in display_options else 0
    st.session_state.selected_event_name  = chosen_event
    st.session_state.selected_event_id    = name_to_id.get(chosen_event, "")

    st.write("")

    # ── CLOCK IN — only shown when not clocked in ──────────────────────────
    if st.session_state.start_time is None:
        if st.button("🟢  CLOCK IN", use_container_width=True):
            if not st.session_state.user_email:
                st.error("Enter your email in the sidebar first.")
            else:
                st.session_state.start_time = utc_now()
                dbg(f"Clocked IN | event={chosen_event!r} | start={st.session_state.start_time}")
                st.rerun()
    else:
        st.success(f"✅ Clocked in at {fmt_time(st.session_state.start_time)} — {fmt_duration(utc_now() - st.session_state.start_time)} elapsed")

    # ── CLOCK OUT — only shown when clocked in ─────────────────────────────
    if st.session_state.start_time is not None:
        if st.button("🔴  CLOCK OUT", use_container_width=True):
            captured_start = st.session_state.start_time
            captured_end   = utc_now()
            duration       = captured_end - captured_start
            hours          = duration.total_seconds() / 3600
            dbg(f"Clocked OUT | duration={fmt_duration(duration)} ({hours:.4f}h)")

            pushed, push_err = False, ""
            if neon_configured() and st.session_state.account_id:
                with st.spinner("Saving to NeonCRM…"):
                    pushed, push_err = push_shift_to_neon(
                        account_id = st.session_state.account_id,
                        event_id   = st.session_state.selected_event_id,
                        start_dt   = captured_start,
                        end_dt     = captured_end,
                        hours      = hours,
                        note       = f"Logged via Volunteer Portal – {chosen_event}",
                    )
                    dbg(f"push → pushed={pushed} err={push_err!r}")
