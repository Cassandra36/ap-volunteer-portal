# NEONCRM
# ---------------------------------------------------------------------------
NEON_BASE    = "https://api.neoncrm.com/v2"
NEON_VERSION = "2.9"

def neon_configured():
    try:
        _ = st.secrets["neon"]["api_key"]
        _ = st.secrets["neon"]["org_id"]
        return True
    except Exception:
        return False

def _neon_headers():
    org_id  = st.secrets["neon"]["org_id"]
    api_key = st.secrets["neon"]["api_key"]
    token   = base64.b64encode(f"{org_id}:{api_key}".encode()).decode()
    return {
        "Authorization":    f"Basic {token}",
        "Content-Type":     "application/json",
        "NEON-API-VERSION": NEON_VERSION,
    }

# ── Events ──────────────────────────────────────────────────────────────────
@st.cache_data(ttl=300)
def fetch_neon_events():
    url    = f"{NEON_BASE}/events"
    params = {"currentPage": 0, "pageSize": 200, "sortColumn": "startDate", "sortDirection": "ASC"}
    try:
        resp = requests.get(url, headers=_neon_headers(), params=params, timeout=10)
    except Exception as e:
        return [], str(e)
    if not resp.ok:
        return [], f"HTTP {resp.status_code}: {resp.text[:200]}"
    today = datetime.date.today()
    raw   = resp.json().get("events") or []
    parsed = []
    for ev in raw:
        name     = ev.get("name", "Untitled")
        reg_open = ev.get("enableEventRegistrationForm", False)
        start    = ev.get("startDate", "")
        if "template" in name.lower() or not reg_open:
            continue
        try:
            if datetime.date.fromisoformat(start) < today:
                continue
        except ValueError:
            pass
        parsed.append({
            "id":   str(ev.get("id", "")),
            "name": name,
            "date": start,
            "time": ev.get("startTime", ""),
            "type": "event",
        })
    return parsed, ""

# ── Opportunities ────────────────────────────────────────────────────────────
@st.cache_data(ttl=300)
def fetch_neon_opportunities():
    url    = f"{NEON_BASE}/opportunities"
    params = {"currentPage": 0, "pageSize": 200}
    try:
        resp = requests.get(url, headers=_neon_headers(), params=params, timeout=10)
    except Exception as e:
        return [], str(e)
    dbg(f"GET /opportunities → HTTP {resp.status_code}")
    if not resp.ok:
        return [], f"HTTP {resp.status_code}: {resp.text[:200]}"
    raw = resp.json().get("opportunityList") or []
    parsed = []
    for opp in raw:
        name   = opp.get("name", "Untitled")
        status = str(opp.get("status", "")).strip().upper()
        if "template" in name.lower():
            continue
        if status and status != "ACTIVE":
            continue
        parsed.append({
            "id":   str(opp.get("id", "")),
            "name": name,
            "date": "",
            "time": "",
            "type": "opportunity",
        })
    return parsed, ""

# ── Account lookup ───────────────────────────────────────────────────────────
@st.cache_data(ttl=60)
def fetch_account_id(email):
    url    = f"{NEON_BASE}/accounts"
    params = {"userType": "INDIVIDUAL", "email": email, "currentPage": 0, "pageSize": 1}
    try:
        resp = requests.get(url, headers=_neon_headers(), params=params, timeout=10)
    except Exception as e:
        return None, str(e)
    if not resp.ok:
        return None, f"HTTP {resp.status_code}: {resp.text[:200]}"
    try:
        accounts = resp.json().get("accounts") or []
        if accounts:
            return str(accounts[0].get("accountId", "")), ""
        return None, ""
    except Exception as e:
        return None, str(e)

# ── Fetch hours + inspect timesheet structure ────────────────────────────────
@st.cache_data(ttl=60)
def fetch_volunteer_hours(account_id):
    url    = f"{NEON_BASE}/timesheets"
    params = {"currentPage": 0, "pageSize": 5}
    try:
        resp = requests.get(url, headers=_neon_headers(), params=params, timeout=10)
        if not resp.ok:
            dbg(f"GET /timesheets → HTTP {resp.status_code}: {resp.text[:200]}")
            return 0.0, {}
        rows = resp.json().get("timesheets") or []
        # Log a sample record so we know the exact field names NeonCRM uses
        sample = rows[0] if rows else {}
        dbg(f"Timesheet sample keys: {list(sample.keys())}")
        dbg(f"Timesheet sample: {sample}")
    except Exception as e:
        dbg(f"fetch_volunteer_hours error: {e}")
        return 0.0, {}

    # Fetch all and filter by account using every possible field name
    try:
        params2 = {"currentPage": 0, "pageSize": 500}
        resp2   = requests.get(url, headers=_neon_headers(), params=params2, timeout=10)
        all_rows = resp2.json().get("timesheets") or []
        total = 0.0
        for r in all_rows:
            for field in ("accountId", "account_id", "constituentId", "contactId", "volunteerId"):
                if str(r.get(field, "")) == str(account_id):
                    total += float(r.get("hours", 0) or 0)
                    break
        return round(total, 2), sample
    except Exception as e:
        dbg(f"fetch_volunteer_hours total error: {e}")
        return 0.0, sample

# ── Push shift ───────────────────────────────────────────────────────────────
def push_shift_to_neon(account_id, item_id, item_type, start_dt, end_dt, hours, note):
    url         = f"{NEON_BASE}/timesheets"
    local_start = start_dt.astimezone(LOCAL_TZ)
    local_end   = end_dt.astimezone(LOCAL_TZ)

    # Base payload — matches structure of manually-created timesheets
    payload = {
        "accountId": account_id,
        "hours":     round(hours, 2),
        "startDate": local_start.strftime("%Y-%m-%d"),
        "endDate":   local_end.strftime("%Y-%m-%d"),
        "startTime": local_start.strftime("%H:%M:%S"),
        "endTime":   local_end.strftime("%H:%M:%S"),
        "note":      note,
    }

    dbg(f"POST /timesheets payload: {payload}")
    try:
        resp = requests.post(url, headers=_neon_headers(), json=payload, timeout=10)
    except Exception as e:
        return False, str(e)

    dbg(f"POST /timesheets → HTTP {resp.status_code} | {resp.text[:300]!r}")
    if resp.ok:
        return True, ""
    return False, f"HTTP {resp.status_code}: {resp.text[:300]}"

