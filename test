                        )

            st.session_state.history.append({
                "date":       to_local(captured_end).strftime("%b %d, %Y"),
                "event":      chosen_event,
                "clock_in":   fmt_time(captured_start),
                "clock_out":  fmt_time(captured_end),
                "duration_h": round(hours, 2),
            })
            if not pushed:
                st.session_state.total_hours = round(
                    st.session_state.total_hours + hours, 2
                )

            st.session_state.start_time = None  # clear last, after all reads

            st.balloons()
            if pushed:
                st.success(
                    f"✅ Saved to NeonCRM!\n\n"
                    f"**Duration:** {fmt_duration(duration)} · **Event:** {chosen_event}"
                )
            else:
                st.warning(
                    f"Shift saved locally but NeonCRM push failed: {push_err}\n\n"
                    f"**Duration:** {fmt_duration(duration)}"
                )

    st.write("")
    if not st.session_state.start_time:
        st.info("⚪ Not currently clocked in")

